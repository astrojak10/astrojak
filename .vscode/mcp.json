{
  "inputs": [
    {
      "type": "promptString",
      "id": "shopify-client-id",
      "description": "Shopify Client ID",
      "password": true
    },
    {
      "type": "promptString",
      "id": "shopify-client-secret",
      "description": "Shopify Client Secret",
      "password": true
    }
  ],
  "servers": {
    "shopify-dev-mcp": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@shopify/dev-mcp@latest"
      ]
    },
    "shopify-store": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "shopify-mcp"
      ],
      "env": {
        "SHOPIFY_CLIENT_ID": "${input:shopify-client-id}",
        "SHOPIFY_CLIENT_SECRET": "${input:shopify-client-secret}",
        "MYSHOPIFY_DOMAIN": "astrojak.myshopify.com"
      }
    }
  }
}
